# Copy this file to .env.local and fill it in. .env.local is never shared or committed.

# Your Spring Boot backend. Sign-in and the Shop (categories and products) use it.
# ngrok URLs change when the tunnel restarts: update this and restart `npm run dev`.
# Leave empty to run everything on demo data.
VITE_API_BASE_URL=

# Older, unused REST adapter (src/api/http.ts). Leave empty.
# Leave empty to run on local demo data (saved in this browser).
# Set it to your backend's URL to use the real API, e.g. https://api.panchayat.app
VITE_ADMIN_API_URL=

# Each staff member's own password (demo mode only; the backend checks real accounts).
# An account with no password here can't sign in.
VITE_PASS_ARYAN=
VITE_PASS_BHARAT=
VITE_PASS_NIKHIL=
VITE_PASS_SHIVAM=
VITE_PASS_VANSH=
